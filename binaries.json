{
    "fzf": {
        "repo": "junegunn/fzf",
        "asset_regex": "fzf.*linux.*amd64.*",
        "file_map": {
            "fzf": "usr/bin/fzf"
        }
    },
    "fzf-misc": {
        "repo": "junegunn/fzf",
        "asset_regex": "SOURCE_CODE_ASSET.zip",
        "file_map": {
            "shell/completion.zsh": "usr/local/share/zsh/site-functions/fzf-completion.zsh",
            "shell/key-bindings.zsh": "usr/local/share/zsh/site-functions/fzf-key-bindings.zsh",
            "man/man1/fzf.1": "usr/share/man/man1/fzf.1"
        }
    },
    "eza": {
        "repo": "eza-community/eza",
        "asset_regex": "eza_x86_64-unknown-linux-musl.zip",
        "file_map": {
            "eza": "usr/bin/eza"
        }
    },
    "eza-man": {
        "repo": "eza-community/eza",
        "asset_regex": "man.*.tar.gz",
        "file_map": {
            "./target/man-[^/]*/eza.1": "usr/share/man/man1/eza.1",
            "./target/man-[^/]*/eza_colors-explanation.5": "usr/share/man/man1/eza_colors-explanation.5",
            "./target/man-[^/]*/eza_colors.5": "usr/share/man/man1/eza_colors.5"
        }
    },
    "eza-completion": {
        "repo": "eza-community/eza",
        "asset_regex": "completions.*.tar.gz",
        "file_map": {
            "./target/completions-[^/]*/_eza": "usr/local/share/zsh/site-functions/eza.zsh"
        }
    },
    "vim": {
        "repo": "neovim/neovim",
        "asset_regex": "nvim-linux-x86_64.appimage",
        "file_map": {
            "nvim-linux-x86_64.appimage": "usr/bin/nvim"
        }
    },
    "delta": {
        "repo": "dandavison/delta",
        "asset_regex": "delta-.*-x86_64-unknown-linux-gnu\\.tar\\.gz",
        "file_map": {
            "[^/]*/delta": "usr/bin/delta"
        }
    },
    "bat": {
        "repo": "sharkdp/bat",
        "asset_regex": "bat-.*-x86_64-unknown-linux-musl\\.tar\\.gz",
        "file_map": {
            "[^/]*/bat": "usr/bin/bat",
            "[^/]*/bat.1": "usr/share/man/man1/bat.1",
            "[^/]*/autocomplete/bat.zsh": "usr/local/share/zsh/site-functions/bat.zsh"
        }
    },
    "tmux": {
        "repo": "nelsonenzo/tmux-appimage",
        "asset_regex": "tmux.appimage",
        "file_map": {
            "tmux.appimage": "usr/bin/tmux"
        }
    },
    "rg": {
        "repo": "BurntSushi/ripgrep",
        "asset_regex": "ripgrep-.*-x86_64-unknown-linux.*.tar.gz",
        "file_map": {
            "[^/]*/rg": "usr/bin/rg",
            "[^/]*/doc/rg.1": "usr/share/man/man1/rg.1"
        }
    },
    "fd": {
        "repo": "sharkdp/fd",
        "asset_regex": "fd-.*-x86_64-unknown-linux-gnu.tar.gz",
        "file_map": {
            "[^/]*/fd": "usr/bin/fd",
            "[^/]*/fd.1": "usr/share/man/man1/fd.1"
        }
    }
}
